# All variables exposed to the browser MUST start with VITE_.
# Never put secrets here — everything below ends up in the client bundle.

VITE_APP_NAME=Safety Detective

# Base URL for API requests. Use "/api" with the dev proxy below, or a full
# URL (e.g. https://api.example.com/api) when frontend and backend are deployed separately.
VITE_API_BASE_URL=/api
# Request timeout in milliseconds
VITE_API_TIMEOUT=15000

# ── Dev server only (read by vite.config.js) ─────────────
VITE_DEV_PORT=5173
# Where the dev server proxies /api requests to
VITE_API_PROXY_TARGET=http://localhost:5000
